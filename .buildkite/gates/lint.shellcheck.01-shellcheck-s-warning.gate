#!/usr/bin/env bash
# Verbatim `run:` body of GitHub Actions step
#   lint.yml / job shellcheck / step [2] "shellcheck (-S warning)"
# at wave-foundation-public origin/main d922e69. Do not edit by hand: re-extract from the workflow (see .buildkite/README.md).
# gh-shell: default
# Run by .buildkite/scripts/lib/common.sh as `bash -e <this file>` (GH default shell), or `bash -eo pipefail` when the step set `shell: bash`.
shellcheck -S warning $(git ls-files '*.sh')
